{
	"name": "jxp",
	"description": "An opinionated RESTful API library based on Mongoose and Restify. Make an API by just writing Mongoose models.",
	"version": "4.0.0",
	"private": false,
	"main": "dist/libs/jxp.js",
	"types": "dist/libs/jxp.d.ts",
	"files": [
		"dist",
		".env.sample",
		"templates",
		"docs",
		"mkdocs.yml"
	],
	"exports": {
		".": {
			"types": "./dist/libs/jxp.d.ts",
			"default": "./dist/libs/jxp.js"
		},
		"./libs/query_manipulation": {
			"types": "./dist/libs/query_manipulation.d.ts",
			"default": "./dist/libs/query_manipulation.js"
		},
		"./globals": {
			"types": "./dist/globals.d.ts",
			"default": "./dist/globals.js"
		},
		"./libs/load-config": {
			"types": "./dist/libs/load-config.d.ts",
			"default": "./dist/libs/load-config.js"
		},
		"./libs/connection_string": {
			"types": "./dist/libs/connection_string.d.ts",
			"default": "./dist/libs/connection_string.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"start": "node dist/bin/server.js",
		"dev": "nodemon --watch src --ext ts --exec 'npm run build && node dist/bin/server.js'",
		"test": "npm run build && mocha --require test/env.js --timeout 1000 -b --exit",
		"wstest": "npm run build && mocha test/wstest",
		"setup": "node dist/bin/setup.js"
	},
	"bin": {
		"jxp": "dist/bin/setup.js",
		"jxp-setup": "dist/bin/setup.js",
		"jxp-add-admin": "dist/bin/init_db.js"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/WorkSpaceMan/jxp.git"
	},
	"keywords": [
		"api",
		"mongoose",
		"typescript"
	],
	"author": "Jason Norwood-Young <jason@10layer.com> (https://github.com/j-norwood-young/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/WorkSpaceMan/jxp/issues"
	},
	"dependencies": {
		"axios": "^1.8.4",
		"bcryptjs": "^3.0.2",
		"commander": "^13.1.0",
		"dotenv": "^16.5.0",
		"glob": "11.0.1",
		"js-yaml": "4.1.0",
		"json2csv": "^5.0.7",
		"jsonwebtoken": "^9.0.2",
		"jstransformer-markdown-it": "^3.0.0",
		"jxp-helper": "^1.4.3",
		"mkdirp": "^3.0.1",
		"moment": "^2.30.1",
		"mongoose": "6.12.6",
		"mongoose-friendly": "^0.1.4",
		"morgan": "^1.10.0",
		"node-cache": "^5.1.2",
		"nodemailer": "^6.10.1",
		"nodemailer-smtp-transport": "^2.7.4",
		"pug": "^3.0.3",
		"querystring": "^0.2.1",
		"rand-token": "^1.0.1",
		"readline-sync": "^1.4.10",
		"restify": "^11.1.0",
		"restify-cors-middleware2": "^2.2.1",
		"restify-errors": "^8.0.2",
		"traverse": "^0.6.11",
		"underscore": "^1.13.7",
		"ws": "^8.18.1"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.15.21",
		"@types/underscore": "^1.13.0",
		"@types/ws": "^8.18.1",
		"chai": "^4.3.10",
		"chai-http": "^4.4.0",
		"mocha": "^10.2.0",
		"nodemon": "^3.1.0",
		"should": "^13.2.3",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
