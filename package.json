{
	"name": "jxp",
	"description": "An opinionated RESTful API library based on Mongoose and Restify. Make an API by just writing Mongoose models.",
	"version": "5.0.3",
	"private": false,
	"main": "dist/libs/jxp.js",
	"types": "dist/libs/jxp.d.ts",
	"files": [
		"dist",
		".env.sample",
		"templates",
		"docs",
		"mkdocs.yml"
	],
	"exports": {
		".": {
			"types": "./dist/libs/jxp.d.ts",
			"default": "./dist/libs/jxp.js"
		},
		"./libs/schema": {
			"types": "./dist/libs/schema.d.ts",
			"default": "./dist/libs/schema.js"
		},
		"./libs/query_manipulation": {
			"types": "./dist/libs/query_manipulation.d.ts",
			"default": "./dist/libs/query_manipulation.js"
		},
		"./globals": {
			"types": "./dist/globals.d.ts",
			"default": "./dist/globals.js"
		},
		"./libs/load-config": {
			"types": "./dist/libs/load-config.d.ts",
			"default": "./dist/libs/load-config.js"
		},
		"./libs/connection_string": {
			"types": "./dist/libs/connection_string.d.ts",
			"default": "./dist/libs/connection_string.js"
		},
		"./types/jxp-config": {
			"types": "./dist/types/jxp-config.d.ts"
		},
		"./libs/index_diagnostics": {
			"types": "./dist/libs/index_diagnostics.d.ts",
			"default": "./dist/libs/index_diagnostics.js"
		},
		"./libs/builtin_models": {
			"types": "./dist/libs/builtin_models.d.ts",
			"default": "./dist/libs/builtin_models.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/libs/mcp/guides','dist/libs/mcp/guides',{recursive:true})\"",
		"prepublishOnly": "npm run build",
		"prepare": "node -e \"require('fs').existsSync('src')&&require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
		"start": "node dist/bin/server.js",
		"dev": "nodemon --watch src --ext ts --exec 'npm run build && node dist/bin/server.js'",
		"test": "npm run build && mocha --require test/env.js test/builtin_models.test.js test/bulkwrite_guard.test.js test/index_diagnostics.test.js test/mcp_guides.test.js test/mcp_visibility.test.js test/parse_byte_size.test.js test/query_limits.test.js test/request_log.test.js test/schema_description.test.js test/test.js --timeout 1000 -b --exit",
		"setup": "node dist/bin/setup.js",
		"indexes": "node dist/bin/index_audit.js"
	},
	"bin": {
		"jxp": "dist/bin/setup.js",
		"jxp-setup": "dist/bin/setup.js",
		"jxp-add-admin": "dist/bin/init_db.js",
		"jxp-indexes": "dist/bin/index_audit.js",
		"jxp-mcp": "dist/bin/mcp-stdio-bridge.js"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/WorkSpaceMan/jxp.git"
	},
	"keywords": [
		"api",
		"mongoose",
		"typescript"
	],
	"author": "Jason Norwood-Young <jason@10layer.com> (https://github.com/j-norwood-young/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/WorkSpaceMan/jxp/issues"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@json2csv/plainjs": "^7.0.7",
		"@modelcontextprotocol/client": "^2.0.0-beta.5",
		"@modelcontextprotocol/node": "^2.0.0-beta.5",
		"@modelcontextprotocol/server": "^2.0.0-beta.5",
		"bcryptjs": "^3.0.3",
		"bytes": "^3.1.2",
		"commander": "^15.0.0",
		"dotenv": "^17.4.2",
		"glob": "13.0.6",
		"js-yaml": "5.2.1",
		"jsonwebtoken": "^9.0.3",
		"jxp-helper": "^2.0.0",
		"markdown-it": "^14.3.0",
		"moment": "^2.30.1",
		"mongoose": "6.13.10",
		"mongoose-friendly": "^0.1.4",
		"morgan": "^1.11.0",
		"node-cache": "^5.1.2",
		"nodemailer": "^9.0.3",
		"pug": "^3.0.4",
		"rand-token": "^1.0.1",
		"readline-sync": "^1.4.10",
		"restify": "^11.1.0",
		"restify-cors-middleware2": "^2.2.1",
		"restify-errors": "^8.1.0",
		"traverse": "^0.6.11",
		"underscore": "^1.13.8",
		"ws": "^8.21.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "^9.0.10",
		"@types/markdown-it": "^14.1.2",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.1",
		"@types/underscore": "^1.13.0",
		"@types/ws": "^8.18.1",
		"chai": "^4.3.10",
		"chai-http": "^4.4.0",
		"mocha": "^11.7.6",
		"nodemon": "^3.1.14",
		"should": "^13.2.3",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"overrides": {
		"@hono/node-server": "^2.0.5",
		"find-my-way": "^8.2.2",
		"send": "^0.19.0",
		"serialize-javascript": "^7.0.5",
		"diff": "^8.0.3",
		"uuid": "^11.1.1"
	}
}
