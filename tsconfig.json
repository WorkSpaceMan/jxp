{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"lib": ["ES2022"],
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "nodenext",
		"moduleDetection": "force",
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noImplicitAny": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test"]
}
